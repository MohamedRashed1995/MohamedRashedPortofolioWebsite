<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGradHelpDesk" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#051c14" />
      <stop offset="50%" stop-color="#062e21" />
      <stop offset="100%" stop-color="#02140e" />
    </linearGradient>
    <linearGradient id="emeraldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <filter id="emeraldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="10" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bgGradHelpDesk)" />

  <!-- Ambient Glow -->
  <circle cx="700" cy="100" r="160" fill="#10b981" opacity="0.14" filter="url(#emeraldGlow)" />
  <circle cx="100" cy="380" r="130" fill="#059669" opacity="0.12" filter="url(#emeraldGlow)" />

  <!-- Grid pattern -->
  <g opacity="0.06" stroke="#34d399" stroke-width="1">
    <line x1="0" y1="50" x2="800" y2="50" />
    <line x1="0" y1="100" x2="800" y2="100" />
    <line x1="0" y1="150" x2="800" y2="150" />
    <line x1="0" y1="200" x2="800" y2="200" />
    <line x1="0" y1="250" x2="800" y2="250" />
    <line x1="0" y1="300" x2="800" y2="300" />
    <line x1="0" y1="350" x2="800" y2="350" />
    <line x1="0" y1="400" x2="800" y2="400" />

    <line x1="100" y1="0" x2="100" y2="450" />
    <line x1="200" y1="0" x2="200" y2="450" />
    <line x1="300" y1="0" x2="300" y2="450" />
    <line x1="400" y1="0" x2="400" y2="450" />
    <line x1="500" y1="0" x2="500" y2="450" />
    <line x1="600" y1="0" x2="600" y2="450" />
    <line x1="700" y1="0" x2="700" y2="450" />
  </g>

  <!-- Mockup Window Shell -->
  <g transform="translate(60, 45)">
    <rect width="680" height="360" rx="14" fill="#091410" stroke="#064e3b" stroke-width="1.5" filter="drop-shadow(0 20px 30px rgba(0,0,0,0.8))" />

    <!-- Window Top Header Bar -->
    <path d="M 0 14 Q 0 0 14 0 L 666 0 Q 680 0 680 14 L 680 44 L 0 44 Z" fill="#0f291e" />
    <circle cx="22" cy="22" r="5" fill="#ef4444" opacity="0.8" />
    <circle cx="38" cy="22" r="5" fill="#f59e0b" opacity="0.8" />
    <circle cx="54" cy="22" r="5" fill="#10b981" opacity="0.8" />

    <rect x="180" y="12" width="320" height="20" rx="6" fill="#064e3b" opacity="0.6" />
    <text x="340" y="26" fill="#6ee7b7" font-family="monospace" font-size="11" text-anchor="middle">helpdesk.realtime / signalr-hub</text>

    <!-- SignalR Live Badge -->
    <g transform="translate(560, 13)">
      <rect width="95" height="18" rx="9" fill="#10b981" opacity="0.2" stroke="#10b981" stroke-width="1" />
      <circle cx="12" cy="9" r="3.5" fill="#10b981" />
      <text x="54" y="13" fill="#6ee7b7" font-family="system-ui, sans-serif" font-weight="bold" font-size="9" text-anchor="middle">SIGNALR LIVE</text>
    </g>

    <!-- Live SLA Header Metric Cards -->
    <g transform="translate(20, 60)">
      <!-- Card 1 -->
      <rect width="200" height="74" rx="8" fill="#0d241b" stroke="#065f46" stroke-width="1" />
      <text x="14" y="24" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Open Tickets (Real-time)</text>
      <text x="14" y="56" fill="#ffffff" font-family="system-ui, sans-serif" font-size="24" font-weight="800">42</text>
      <rect x="120" y="36" width="65" height="22" rx="4" fill="#ef4444" opacity="0.2" />
      <text x="152" y="51" fill="#f87171" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">3 SLA Alert</text>

      <!-- Card 2 -->
      <g transform="translate(215, 0)">
        <rect width="200" height="74" rx="8" fill="#0d241b" stroke="#065f46" stroke-width="1" />
        <text x="14" y="24" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Avg Resolution Speed</text>
        <text x="14" y="56" fill="#34d399" font-family="system-ui, sans-serif" font-size="24" font-weight="800">14.2m</text>
        <text x="150" y="52" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10">99.2% SLA</text>
      </g>

      <!-- Card 3 -->
      <g transform="translate(430, 0)">
        <rect width="210" height="74" rx="8" fill="#0d241b" stroke="#065f46" stroke-width="1" />
        <text x="14" y="24" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Connected Agents</text>
        <text x="14" y="56" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="24" font-weight="800">18 Active</text>
        <circle cx="175" cy="46" r="6" fill="#10b981" />
      </g>
    </g>

    <!-- Ticket Stream Rows -->
    <g transform="translate(20, 150)">
      <rect width="640" height="190" rx="8" fill="#0a1b14" stroke="#064e3b" stroke-width="1" />
      
      <!-- Table Header -->
      <rect width="640" height="30" rx="6" fill="#0f291e" />
      <text x="20" y="20" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">ID</text>
      <text x="80" y="20" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">SUBJECT</text>
      <text x="280" y="20" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">ASSIGNED AGENT</text>
      <text x="440" y="20" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">SLA TIMER</text>
      <text x="560" y="20" fill="#6ee7b7" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">STATUS</text>

      <!-- Row 1 -->
      <g transform="translate(0, 36)">
        <text x="20" y="20" fill="#94a3b8" font-family="monospace" font-size="11">#TK-809</text>
        <text x="80" y="20" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Payment Gateway webhook timeout</text>
        <text x="280" y="20" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11">Agent Mona (Workload: 4)</text>
        <rect x="440" y="6" width="90" height="20" rx="4" fill="#ef4444" opacity="0.2" />
        <text x="485" y="20" fill="#f87171" font-family="monospace" font-weight="bold" font-size="10" text-anchor="middle">00:14:22</text>
        <rect x="560" y="6" width="60" height="20" rx="4" fill="#f59e0b" opacity="0.2" />
        <text x="590" y="20" fill="#fbbf24" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">In Progress</text>
      </g>
      <line x1="10" y1="70" x2="630" y2="70" stroke="#064e3b" stroke-width="0.7" />

      <!-- Row 2 -->
      <g transform="translate(0, 76)">
        <text x="20" y="20" fill="#94a3b8" font-family="monospace" font-size="11">#TK-810</text>
        <text x="80" y="20" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Database connection pool starvation</text>
        <text x="280" y="20" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11">Agent Tarek (Workload: 7)</text>
        <rect x="440" y="6" width="90" height="20" rx="4" fill="#10b981" opacity="0.2" />
        <text x="485" y="20" fill="#34d399" font-family="monospace" font-weight="bold" font-size="10" text-anchor="middle">02:45:10</text>
        <rect x="560" y="6" width="60" height="20" rx="4" fill="#10b981" opacity="0.2" />
        <text x="590" y="20" fill="#34d399" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Open</text>
      </g>
      <line x1="10" y1="110" x2="630" y2="110" stroke="#064e3b" stroke-width="0.7" />

      <!-- Row 3 -->
      <g transform="translate(0, 116)">
        <text x="20" y="20" fill="#94a3b8" font-family="monospace" font-size="11">#TK-811</text>
        <text x="80" y="20" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">User role sync policy update</text>
        <text x="280" y="20" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="11">Agent Mona (Workload: 4)</text>
        <rect x="440" y="6" width="90" height="20" rx="4" fill="#10b981" opacity="0.2" />
        <text x="485" y="20" fill="#34d399" font-family="monospace" font-weight="bold" font-size="10" text-anchor="middle">08:12:00</text>
        <rect x="560" y="6" width="60" height="20" rx="4" fill="#3b82f6" opacity="0.2" />
        <text x="590" y="20" fill="#60a5fa" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Resolved</text>
      </g>
    </g>
  </g>
</svg>
