<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGradPortfolio" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080e1a" />
      <stop offset="50%" stop-color="#0c182e" />
      <stop offset="100%" stop-color="#061224" />
    </linearGradient>
    <linearGradient id="accentGradPortfolio" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="50%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>
    <linearGradient id="glowViolet" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.05" />
    </linearGradient>
    <filter id="pGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bgGradPortfolio)" />

  <!-- Grid Tech Lines -->
  <g opacity="0.07" stroke="#38bdf8" stroke-width="1">
    <line x1="0" y1="50" x2="800" y2="50" />
    <line x1="0" y1="100" x2="800" y2="100" />
    <line x1="0" y1="150" x2="800" y2="150" />
    <line x1="0" y1="200" x2="800" y2="200" />
    <line x1="0" y1="250" x2="800" y2="250" />
    <line x1="0" y1="300" x2="800" y2="300" />
    <line x1="0" y1="350" x2="800" y2="350" />
    <line x1="0" y1="400" x2="800" y2="400" />

    <line x1="100" y1="0" x2="100" y2="450" />
    <line x1="200" y1="0" x2="200" y2="450" />
    <line x1="300" y1="0" x2="300" y2="450" />
    <line x1="400" y1="0" x2="400" y2="450" />
    <line x1="500" y1="0" x2="500" y2="450" />
    <line x1="600" y1="0" x2="600" y2="450" />
    <line x1="700" y1="0" x2="700" y2="450" />
  </g>

  <!-- Ambient Glow -->
  <circle cx="680" cy="110" r="160" fill="#3b82f6" opacity="0.18" filter="url(#pGlow)" />
  <circle cx="140" cy="360" r="130" fill="#8b5cf6" opacity="0.15" filter="url(#pGlow)" />

  <!-- Mockup Window Shell -->
  <g transform="translate(50, 35)">
    <!-- Browser Window Card -->
    <rect width="700" height="380" rx="14" fill="#091122" stroke="#1e293b" stroke-width="1.5" filter="drop-shadow(0 25px 35px rgba(0,0,0,0.85))" />

    <!-- Window Top Header Bar -->
    <path d="M 0 14 Q 0 0 14 0 L 686 0 Q 700 0 700 14 L 700 44 L 0 44 Z" fill="#0d172e" />
    <circle cx="22" cy="22" r="5" fill="#ef4444" opacity="0.85" />
    <circle cx="38" cy="22" r="5" fill="#f59e0b" opacity="0.85" />
    <circle cx="54" cy="22" r="5" fill="#10b981" opacity="0.85" />

    <!-- URL Bar -->
    <rect x="180" y="12" width="340" height="20" rx="6" fill="#17233f" />
    <text x="350" y="26" fill="#94a3b8" font-family="monospace" font-size="11" text-anchor="middle">rashed-portfolio.dev / &lt;MR /&gt;</text>

    <!-- Top Badge in Header -->
    <g transform="translate(580, 13)">
      <rect width="105" height="18" rx="9" fill="#06b6d4" opacity="0.2" stroke="#06b6d4" stroke-width="1" />
      <circle cx="12" cy="9" r="3.5" fill="#06b6d4" />
      <text x="58" y="13" fill="#67e8f9" font-family="system-ui, sans-serif" font-weight="bold" font-size="9" text-anchor="middle">REACT 18 + VITE</text>
    </g>

    <!-- App Content Inside Mockup -->
    <!-- Left Hero Banner -->
    <g transform="translate(24, 62)">
      <rect width="410" height="150" rx="10" fill="#0e1b36" stroke="#1e293b" stroke-width="1" />
      
      <!-- Brand Emblem -->
      <rect x="16" y="16" width="38" height="38" rx="8" fill="#16274e" stroke="#38bdf8" stroke-width="1" />
      <text x="35" y="39" fill="#38bdf8" font-family="monospace" font-weight="bold" font-size="14" text-anchor="middle">&lt;MR/&gt;</text>
      
      <!-- Hero Text -->
      <text x="66" y="32" fill="#ffffff" font-family="system-ui, sans-serif" font-weight="800" font-size="15">Mohamed Rashed Abdelazim</text>
      <text x="66" y="48" fill="#38bdf8" font-family="monospace" font-size="11">.NET &amp; Full-Stack AI Engineer</text>

      <text x="16" y="80" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11" width="380">
        Enterprise ASP.NET Core Clean Architecture, SignalR Real-Time,
      </text>
      <text x="16" y="96" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">
        Bilingual (AR/EN), Multi-Theme Customizer &amp; AI Evaluation Sandbox.
      </text>

      <!-- Pill Badges -->
      <g transform="translate(16, 114)">
        <rect width="80" height="22" rx="5" fill="#3b82f6" opacity="0.2" stroke="#3b82f6" stroke-width="0.8" />
        <text x="40" y="15" fill="#93c5fd" font-family="monospace" font-size="10" text-anchor="middle">Clean Arch</text>

        <rect x="90" width="80" height="22" rx="5" fill="#10b981" opacity="0.2" stroke="#10b981" stroke-width="0.8" />
        <text x="130" y="15" fill="#6ee7b7" font-family="monospace" font-size="10" text-anchor="middle">SignalR Hub</text>

        <rect x="180" width="90" height="22" rx="5" fill="#8b5cf6" opacity="0.2" stroke="#8b5cf6" stroke-width="0.8" />
        <text x="225" y="15" fill="#c4b5fd" font-family="monospace" font-size="10" text-anchor="middle">AI Playground</text>

        <rect x="280" width="105" height="22" rx="5" fill="#f59e0b" opacity="0.2" stroke="#f59e0b" stroke-width="0.8" />
        <text x="332" y="15" fill="#fde68a" font-family="monospace" font-size="10" text-anchor="middle">AR / EN RTL-LTR</text>
      </g>
    </g>

    <!-- Right Live Avatar & Palette Preview -->
    <g transform="translate(450, 62)">
      <rect width="226" height="150" rx="10" fill="#0e1b36" stroke="#1e293b" stroke-width="1" />
      
      <!-- Palette Swatches Header -->
      <text x="16" y="24" fill="#f8fafc" font-family="system-ui, sans-serif" font-weight="700" font-size="11">Active Palette &amp; Accent</text>
      
      <!-- Swatches -->
      <g transform="translate(16, 36)">
        <circle cx="12" cy="12" r="10" fill="#06b6d4" stroke="#ffffff" stroke-width="1.5" />
        <circle cx="42" cy="12" r="9" fill="#10b981" />
        <circle cx="70" cy="12" r="9" fill="#8b5cf6" />
        <circle cx="98" cy="12" r="9" fill="#3b82f6" />
        <circle cx="126" cy="12" r="9" fill="#f97316" />
        <circle cx="154" cy="12" r="9" fill="#f43f5e" />
      </g>

      <!-- Mini Blob Preview -->
      <g transform="translate(30, 72)">
        <path d="M 30 10 Q 55 5 70 25 Q 85 45 65 65 Q 40 75 25 55 Q 10 35 30 10 Z" fill="url(#accentGradPortfolio)" opacity="0.85" />
        <text x="48" y="44" fill="#ffffff" font-family="system-ui, sans-serif" font-weight="bold" font-size="10" text-anchor="middle">3D BLOB</text>
      </g>

      <!-- Live Speed / Metric -->
      <g transform="translate(125, 78)">
        <text x="0" y="14" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="9">Lighthouse Score</text>
        <text x="0" y="38" fill="#10b981" font-family="system-ui, sans-serif" font-weight="800" font-size="22">100%</text>
        <text x="0" y="52" fill="#38bdf8" font-family="monospace" font-size="9">Vite HMR Build</text>
      </g>
    </g>

    <!-- Bottom Interactive AI & Terminal Showcase -->
    <g transform="translate(24, 226)">
      <!-- AI Playground Card -->
      <rect width="410" height="136" rx="10" fill="#070d1a" stroke="#8b5cf6" stroke-width="1" stroke-opacity="0.5" />
      <rect width="410" height="26" rx="8" fill="#0f1933" />
      <text x="14" y="17" fill="#c4b5fd" font-family="monospace" font-size="10" font-weight="bold">AI Evaluation Lab &amp; Interactive API Mock</text>
      
      <text x="14" y="46" fill="#a78bfa" font-family="monospace" font-size="9">&gt; POST /api/playground/adros/courses/enroll</text>
      <text x="14" y="62" fill="#6ee7b7" font-family="monospace" font-size="9">{ status: 200, latency: "12ms", payload: "EnrollmentConfirmed" }</text>
      <text x="14" y="80" fill="#94a3b8" font-family="monospace" font-size="9">&gt; Gemini Code Review: Hallucination Detection Test [PASSED]</text>
      <text x="14" y="98" fill="#38bdf8" font-family="monospace" font-size="9">&gt; Multi-Language Router: Language Context switch -&gt; "ar" / "en"</text>

      <rect x="14" y="108" width="382" height="18" rx="4" fill="#8b5cf6" opacity="0.15" />
      <text x="205" y="121" fill="#c4b5fd" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">✓ Interactive Endpoints • Zero Mock Dependencies</text>

      <!-- Right Tech Stack Grid -->
      <g transform="translate(426, 0)">
        <rect width="226" height="136" rx="10" fill="#0e1b36" stroke="#1e293b" stroke-width="1" />
        <rect width="226" height="26" rx="8" fill="#132347" />
        <text x="14" y="17" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">Core Architecture Stack</text>

        <g transform="translate(14, 38)">
          <text x="0" y="12" fill="#f8fafc" font-family="monospace" font-size="10">⚡ React 18 + Vite</text>
          <text x="0" y="28" fill="#f8fafc" font-family="monospace" font-size="10">🎨 Tailwind CSS v4</text>
          <text x="0" y="44" fill="#f8fafc" font-family="monospace" font-size="10">✨ Framer Motion 3D</text>
          <text x="0" y="60" fill="#f8fafc" font-family="monospace" font-size="10">🌐 RTL/LTR i18n Core</text>
          <text x="0" y="76" fill="#f8fafc" font-family="monospace" font-size="10">🤖 Google AI Studio</text>
        </g>
      </g>
    </g>
  </g>
</svg>
