<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGradDent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a1226" />
      <stop offset="50%" stop-color="#0f1f42" />
      <stop offset="100%" stop-color="#060c1c" />
    </linearGradient>
    <linearGradient id="blueGlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#60a5fa" />
    </linearGradient>
    <filter id="blueGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="10" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bgGradDent)" />

  <!-- Ambient Glow -->
  <circle cx="680" cy="120" r="150" fill="#3b82f6" opacity="0.18" filter="url(#blueGlow)" />
  <circle cx="120" cy="360" r="120" fill="#1d4ed8" opacity="0.14" filter="url(#blueGlow)" />

  <!-- Grid pattern -->
  <g opacity="0.06" stroke="#60a5fa" stroke-width="1">
    <line x1="0" y1="50" x2="800" y2="50" />
    <line x1="0" y1="100" x2="800" y2="100" />
    <line x1="0" y1="150" x2="800" y2="150" />
    <line x1="0" y1="200" x2="800" y2="200" />
    <line x1="0" y1="250" x2="800" y2="250" />
    <line x1="0" y1="300" x2="800" y2="300" />
    <line x1="0" y1="350" x2="800" y2="350" />
    <line x1="0" y1="400" x2="800" y2="400" />

    <line x1="100" y1="0" x2="100" y2="450" />
    <line x1="200" y1="0" x2="200" y2="450" />
    <line x1="300" y1="0" x2="300" y2="450" />
    <line x1="400" y1="0" x2="400" y2="450" />
    <line x1="500" y1="0" x2="500" y2="450" />
    <line x1="600" y1="0" x2="600" y2="450" />
    <line x1="700" y1="0" x2="700" y2="450" />
  </g>

  <!-- Mockup Window Shell -->
  <g transform="translate(60, 45)">
    <rect width="680" height="360" rx="14" fill="#0b1329" stroke="#1e3a8a" stroke-width="1.5" filter="drop-shadow(0 20px 30px rgba(0,0,0,0.8))" />

    <!-- Window Top Header Bar -->
    <path d="M 0 14 Q 0 0 14 0 L 666 0 Q 680 0 680 14 L 680 44 L 0 44 Z" fill="#111c38" />
    <circle cx="22" cy="22" r="5" fill="#ef4444" opacity="0.8" />
    <circle cx="38" cy="22" r="5" fill="#f59e0b" opacity="0.8" />
    <circle cx="54" cy="22" r="5" fill="#10b981" opacity="0.8" />

    <rect x="180" y="12" width="320" height="20" rx="6" fill="#1e293b" opacity="0.8" />
    <text x="340" y="26" fill="#93c5fd" font-family="monospace" font-size="11" text-anchor="middle">dentzone.portal / clinic-management</text>

    <!-- Header Stats -->
    <g transform="translate(20, 60)">
      <!-- Card 1 -->
      <rect width="200" height="74" rx="8" fill="#121e42" stroke="#1d4ed8" stroke-width="1" />
      <text x="14" y="24" fill="#93c5fd" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Today's Appointments</text>
      <text x="14" y="56" fill="#ffffff" font-family="system-ui, sans-serif" font-size="24" font-weight="800">18 Visits</text>
      <circle cx="170" cy="46" r="14" fill="#3b82f6" opacity="0.2" />
      <text x="170" y="50" fill="#60a5fa" font-size="12" font-weight="bold" text-anchor="middle">📅</text>

      <!-- Card 2 -->
      <g transform="translate(215, 0)">
        <rect width="200" height="74" rx="8" fill="#121e42" stroke="#1d4ed8" stroke-width="1" />
        <text x="14" y="24" fill="#93c5fd" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Total Registered Patients</text>
        <text x="14" y="56" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="24" font-weight="800">1,480</text>
        <text x="150" y="52" fill="#34d399" font-family="system-ui, sans-serif" font-size="10">+12% MoM</text>
      </g>

      <!-- Card 3 -->
      <g transform="translate(430, 0)">
        <rect width="210" height="74" rx="8" fill="#121e42" stroke="#1d4ed8" stroke-width="1" />
        <text x="14" y="24" fill="#93c5fd" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Invoices &amp; Billing</text>
        <text x="14" y="56" fill="#10b981" font-family="system-ui, sans-serif" font-size="24" font-weight="800">$24,850</text>
        <rect x="140" y="38" width="55" height="18" rx="4" fill="#10b981" opacity="0.2" />
        <text x="167" y="51" fill="#34d399" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">98% PAID</text>
      </g>
    </g>

    <!-- Appointment Schedule & Treatment Plan View -->
    <g transform="translate(20, 150)">
      <!-- Left Schedule Calendar List -->
      <rect width="390" height="190" rx="8" fill="#0d1733" stroke="#1e3a8a" stroke-width="1" />
      <rect width="390" height="30" rx="6" fill="#121f45" />
      <text x="16" y="20" fill="#93c5fd" font-family="system-ui, sans-serif" font-size="11" font-weight="bold">Upcoming Schedule (Dr. Hana)</text>
      
      <!-- Appt Row 1 -->
      <g transform="translate(14, 40)">
        <rect width="362" height="38" rx="6" fill="#14234d" />
        <circle cx="20" cy="19" r="10" fill="#3b82f6" opacity="0.3" />
        <text x="20" y="23" fill="#60a5fa" font-size="10" font-weight="bold" text-anchor="middle">MS</text>
        <text x="40" y="18" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Mahmoud Samy</text>
        <text x="40" y="30" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="9">Root Canal Consultation • Tooth #14</text>
        <rect x="270" y="10" width="80" height="18" rx="4" fill="#10b981" opacity="0.2" />
        <text x="310" y="23" fill="#34d399" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">10:00 AM</text>
      </g>

      <!-- Appt Row 2 -->
      <g transform="translate(14, 86)">
        <rect width="362" height="38" rx="6" fill="#14234d" />
        <circle cx="20" cy="19" r="10" fill="#3b82f6" opacity="0.3" />
        <text x="20" y="23" fill="#60a5fa" font-size="10" font-weight="bold" text-anchor="middle">LF</text>
        <text x="40" y="18" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Laila Farouk</text>
        <text x="40" y="30" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="9">Orthodontics Follow-up</text>
        <rect x="270" y="10" width="80" height="18" rx="4" fill="#3b82f6" opacity="0.2" />
        <text x="310" y="23" fill="#60a5fa" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">11:30 AM</text>
      </g>

      <!-- Appt Row 3 -->
      <g transform="translate(14, 132)">
        <rect width="362" height="38" rx="6" fill="#14234d" />
        <circle cx="20" cy="19" r="10" fill="#3b82f6" opacity="0.3" />
        <text x="20" y="23" fill="#60a5fa" font-size="10" font-weight="bold" text-anchor="middle">KA</text>
        <text x="40" y="18" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Karim Adel</text>
        <text x="40" y="30" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="9">Teeth Whitening Session</text>
        <rect x="270" y="10" width="80" height="18" rx="4" fill="#f59e0b" opacity="0.2" />
        <text x="310" y="23" fill="#fbbf24" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">01:15 PM</text>
      </g>

      <!-- Right Dental Chart Preview -->
      <g transform="translate(405, 0)">
        <rect width="235" height="190" rx="8" fill="#0d1733" stroke="#1e3a8a" stroke-width="1" />
        <rect width="235" height="30" rx="6" fill="#121f45" />
        <text x="14" y="20" fill="#93c5fd" font-family="system-ui, sans-serif" font-size="11" font-weight="bold">Odontogram &amp; Treatment</text>

        <!-- Dental Arch Nodes -->
        <g transform="translate(20, 45)">
          <circle cx="20" cy="20" r="12" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5" />
          <text x="20" y="24" fill="#ffffff" font-size="8" text-anchor="middle">18</text>

          <circle cx="55" cy="14" r="12" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5" />
          <text x="55" y="18" fill="#ffffff" font-size="8" text-anchor="middle">17</text>

          <circle cx="95" cy="10" r="14" fill="#ef4444" opacity="0.8" stroke="#ffffff" stroke-width="1.5" />
          <text x="95" y="14" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">14</text>

          <circle cx="140" cy="14" r="12" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5" />
          <text x="140" y="18" fill="#ffffff" font-size="8" text-anchor="middle">12</text>

          <circle cx="175" cy="20" r="12" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5" />
          <text x="175" y="24" fill="#ffffff" font-size="8" text-anchor="middle">11</text>
        </g>

        <!-- Treatment Tag -->
        <rect x="16" y="96" width="202" height="34" rx="6" fill="#14234d" />
        <text x="26" y="112" fill="#f87171" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">Tooth #14: Pulpitis Detected</text>
        <text x="26" y="124" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="8">Endodontic therapy planned</text>

        <rect x="16" y="140" width="202" height="34" rx="6" fill="#14234d" />
        <text x="26" y="156" fill="#34d399" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">EF Core + Angular Architecture</text>
        <text x="26" y="168" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="8">Clean Architecture Backend</text>
      </g>
    </g>
  </g>
</svg>
